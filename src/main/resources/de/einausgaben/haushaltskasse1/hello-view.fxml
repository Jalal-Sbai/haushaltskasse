<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.einausgaben.haushaltskasse1.view.ViewController"
      spacing="10"
      alignment="TOP_CENTER">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="5">
        <TextField fx:id="beschreibungField" promptText="Beschreibung"/>
        <TextField fx:id="betragField" promptText="Betrag"/>
        <Button text="Einnahme" onAction="#addEinkommen"/>
        <Button text="Ausgabe" onAction="#addAusgabe"/>
    </HBox>

    <TableView fx:id="table">
        <columns>
            <TableColumn fx:id="beschreibungColumn" text="Beschreibung" prefWidth="150"/>
            <TableColumn fx:id="betragColumn" text="Betrag" prefWidth="100"/>
        </columns>
    </TableView>

    <Label fx:id="saldoLabel" text="Saldo: 0.0 €"/>
    <Button text="CSV speichern" onAction="#speichereCSV"/>

</VBox>